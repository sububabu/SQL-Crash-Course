-- 914. Find the Subtasks That Did Not Execute
--select * from Tasks_1914 -- USE of Recursive CTE --
WITH     cte
AS       (SELECT task_id,
                 subtasks_count,
                 1 AS subtasks_id
          FROM   Tasks_1914
          UNION ALL
          SELECT task_id,
                 subtasks_count,
                 subtasks_id + 1
          FROM   cte
          WHERE  subtasks_id < subtasks_count)
SELECT   c.task_id,
         c.subtasks_id
FROM     cte AS c
         LEFT OUTER JOIN
         Executed_1914 AS e
         ON c.task_id = e.task_id
            AND c.subtasks_id = e.subtask_id
WHERE    e.task_id IS NULL
         AND e.subtask_id IS NULL
ORDER BY task_id, subtasks_id;

