-- 1981. Maximum Transaction Each Day
--select * from Transactions_1981
WITH     Transactions
AS       (SELECT transaction_id,
                 CAST (day AS DATE) AS dayss,
                 amount
          FROM   Transactions_1981)
SELECT   transaction_id
FROM     (SELECT transaction_id,
                 dayss,
                 amount,
                 dense_rank() OVER (PARTITION BY dayss ORDER BY amount DESC) AS rn
          FROM   Transactions) AS t
WHERE    rn = 1
ORDER BY transaction_id;

-- 2024. Calculate Special Bonus
--select * from Employees_2024
SELECT employee_id,
       CASE WHEN (employee_id % 2 = 0)
                 OR name LIKE 'M%' THEN 0 ELSE salary END AS bonus
FROM   Employees_2024;

-- 2041. The Latest Login in 2020
--select * from  Logins_2041
WITH     logins
AS       (SELECT user_id,
                 time_stamp
          FROM   Logins_2041
          WHERE  year(time_stamp) = 2020)
SELECT   user_id,
         max(time_stamp) AS last_stamp
FROM     logins
GROUP BY user_id;

-- 2110. Employees With Missing Information
--select * from Employees_2110
--select * from Salaries_2110
WITH     cte
AS       (SELECT e.employee_id AS emp1,
                 s.employee_id AS emp2
          FROM   Employees_2110 AS e
                 FULL OUTER JOIN
                 Salaries_2110 AS s
                 ON e.employee_id = s.employee_id)
SELECT   emp1 AS employee_id
FROM     cte
WHERE    emp2 IS NULL
UNION ALL
SELECT   emp2 AS employee_id
FROM     cte
WHERE    emp1 IS NULL
ORDER BY employee_id;
