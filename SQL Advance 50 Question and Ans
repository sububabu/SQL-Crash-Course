          UNION ALL
          SELECT year,
                 Au_open AS slams
          FROM   Championships_1932)
SELECT   p.player_id AS player_id,
         p.player_name AS player_name,
         count(player_id) AS grand_slams_count
FROM     cte AS c
         LEFT OUTER JOIN
         Players_1932 AS p
         ON c.slams = p.player_id
GROUP BY player_id, player_name;

-- 1948. Rearrange Products Table
--select * from Products_1948
SELECT   product_id,
         'store1' AS store,
         store1 AS price
FROM     Products_1948
UNION ALL
SELECT   product_id,
         'store2' AS store,
         store2 AS price
FROM     Products_1948
WHERE    store2 IS NOT NULL
UNION ALL
SELECT   product_id,
         'store3' AS store,
         store3 AS price
FROM     Products_1948
ORDER BY product_id, store;

