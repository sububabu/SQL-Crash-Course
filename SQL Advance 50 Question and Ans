-- 1339. Team Scores in Football Tournament
-- select * from Teams_1339
-- select * from Matches_1339
--(Need to add the Points then for home and guest team then do the union all then Join )
WITH     cte
AS       (SELECT *,
                 CASE WHEN host_goals > guest_goals THEN 3 WHEN host_goals = guest_goals THEN 1 ELSE 0 END AS points_host,
                 CASE WHEN guest_goals < host_goals THEN 0 WHEN host_goals = guest_goals THEN 1 ELSE 3 END AS points_guest
          FROM   Matches_1339),
         cte2
AS       (SELECT   host_team AS team_name,
                   sum(points_host) AS num_points
          FROM     cte
          GROUP BY host_team
          UNION ALL
          SELECT   guest_team AS team_name,
                   sum(points_guest) AS num_points
          FROM     cte
          GROUP BY guest_team),
         cte3
AS       (SELECT   team_name,
                   sum(num_points) AS num_points
          FROM     cte2
          GROUP BY team_name)
SELECT   t.team_id,
         t.team_name,
         COALESCE (c.num_points, 0) AS num_points
FROM     cte3 AS c
         RIGHT OUTER JOIN
         Teams_1339 AS t
         ON c.team_name = t.team_id
ORDER BY num_points DESC, team_id ASC;

--1357. Report Contiguous Dates
-- select * from Succeeded_1357
-- select * from Failed_1357
WITH     cte
AS       (SELECT success_date AS dates,
                 'succeeded' AS period_state
          FROM   Succeeded_1357
          WHERE  year(success_date) > 2018
          UNION ALL
          SELECT fail_date AS dates,
                 'failed' AS period_state
          FROM   Failed_1357
          WHERE  year(fail_date) > 2018),
         cte2
AS       (SELECT *,
                 SUM(new_gropup) OVER (ORDER BY dates) AS catagory
          FROM   (SELECT *,
                         CASE WHEN period_state <> COALESCE (previous_state, 'NA') THEN 1 ELSE 0 END AS new_gropup
                  FROM   (SELECT *,
                                 lag(period_state) OVER (ORDER BY dates) AS previous_state
                          FROM   cte) AS t) AS y)
SELECT   period_state,
         min(dates) AS start_dates,
         max(dates) AS end_date
FROM     cte2
GROUP BY period_state, catagory;

