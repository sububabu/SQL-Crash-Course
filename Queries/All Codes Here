--1321. Restaurant Growth-- (doubtfull) 

with  everyday_total as 
(
select visited_on,sum(amount) total_amount from Customer
GROUP BY visited_on
)
,cte2 as (
select visited_on ,
sum(total_amount) over (order by visited_on rows BETWEEN 6 preceding and CURRENT row) as amountSum,
ROW_NUMBER() OVER (ORDER BY visited_on) AS Week 
from everyday_total)
SELECT 
    visited_on,
    amountSum AS amount,
    ROUND(amountSum / 7.0, 2) AS average_amount
FROM cte2
WHERE Week >= 7
ORDER BY visited_on;


