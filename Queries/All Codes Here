--1484. Group Sold Products By The Date

SELECT 
    sell_date,count(product) as num_sold,
    STRING_AGG(product, ',') WITHIN GROUP (ORDER BY product) AS products
FROM (SELECT DISTINCT sell_date, product FROM Activities) as a
GROUP BY sell_date;


